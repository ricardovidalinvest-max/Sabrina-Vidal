# ==============================================================================
# VARIÁVEIS DE AMBIENTE - SISTEMA DRA. SABRINA VIDAL (NUTRIÇÃO SOCIAL)
# Instruções: Copie este arquivo para ".env" e preencha os valores antes do deploy.
# NUNCA envie o arquivo ".env" com credenciais reais para o GitHub!
# ==============================================================================

# 1. SERVIDOR E AMBIENTE (Hostinger / Produção)
NODE_ENV=production
PORT=3000
APP_URL=https://sabrinavidal.com.br

# 2. SEGURANÇA E ACESSO RESTRITO
# Senha mestra para acessar o painel exclusivo da nutricionista no rodapé
ADMIN_PASSWORD=

# 3. ASAAS (Gateway de Pagamentos PIX)
# Chave de API: Minha Conta > Configurações > Integrações > Chaves de API
ASAAS_API_KEY=
# "production" para transações bancárias reais ou "sandbox" para testes
ASAAS_ENVIRONMENT=production
# Token de segurança gerado no Asaas e validado no webhook (header 'asaas-access-token')
ASAAS_WEBHOOK_TOKEN=

# 4. CAL.COM (Agendamento & Sincronização Google Calendar)
# Chave de API: Configurações > Desenvolvedor > API Keys (API v2)
CALCOM_API_KEY=
# Segredo para validação de assinatura HMAC SHA-256 no header 'x-cal-signature-256'
CALCOM_WEBHOOK_SECRET=
# URL base da API v2 do Cal.com (padrão oficial)
CALCOM_BASE_URL=https://api.cal.com/v2
# Link oficial do tipo de evento no Cal.com
CALCOM_EVENT_URL=https://cal.com/sabrina-amorim-tkood0/agendamentos-de-consultas

# 5. Z-API (WhatsApp Transacional Oficial)
# ID da Instância conectada ao número da nutricionista (Hostinger Environment Variable)
ZAPI_INSTANCE_ID=3FB2B3C4ABE0E161991CBEBF5C448C78
# Token da Instância Z-API
ZAPI_TOKEN=0BC27FC112C8DFDBAF9AE3A7
# Client-Token de segurança da conta Z-API (obtenha em Z-API > Segurança se sua conta exigir)
ZAPI_CLIENT_TOKEN=
# URL base do endpoint da Z-API (sempre a raiz oficial)
ZAPI_BASE_URL=https://api.z-api.io

# 6. REGRAS DE NEGÓCIO DA CONSULTA
# Valor em Reais (BRL) cobrado no PIX dinâmico
CONSULTATION_PRICE_BRL=79.00
# Minutos de tolerância para pagamento antes da liberação do horário
PIX_EXPIRATION_MINUTES=15
# E-mail de notificação dos novos agendamentos confirmados
SABRINA_NOTIFICATION_EMAIL=nutricionistasabrinaamorim@gmail.com

# 7. BANCO DE DADOS (PostgreSQL - Opcional se for utilizar persistência externa)
DATABASE_URL=

# 8. WEBHOOKS SECUNDÁRIOS / INTEGRAÇÕES OPCIONAIS
MAKE_WEBHOOK_URL=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=
