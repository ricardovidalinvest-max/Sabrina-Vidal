# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA DE AGENDAMENTO & PAGAMENTO AUTOMATIZADO FAIL-PROOF
# Integrações: Cal.com | Asaas (PIX) | Z-API (WhatsApp) | PostgreSQL
# ==============================================================================

# 1. BANCO DE DADOS (PostgreSQL / Supabase / Neon / Cloud SQL)
# String de conexão usada pelo Prisma ORM ou Drizzle ORM
DATABASE_URL="postgresql://postgres:sua_senha_segura@localhost:5432/agendamentos_db?schema=public"

# 2. CAL.COM (Agendamento & Sincronização de Agenda)
# Chave de API gerada no Cal.com: Configurações > Desenvolvedor > API Keys
CALCOM_API_KEY="cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Secret para validação da assinatura HMAC SHA-256 no header 'x-cal-signature-256'
CALCOM_WEBHOOK_SECRET="whsec_calcom_segredo_de_assinatura_aqui"
# URL base da API do Cal.com (v2 oficial)
CALCOM_BASE_URL="https://api.cal.com/v2"
# Link público do evento para direcionamento manual se necessário
CALCOM_EVENT_URL="https://cal.com/sabrina-amorim-tkood0/agendamentos-de-consultas"

# 3. ASAAS (Gateway de Pagamentos PIX Dinâmico)
# Chave de API: Minha Conta > Configurações > Integrações > Chaves de API
ASAAS_API_KEY="$aact_YTU5YTE0M2M6N2ZkMS00MzJmLTg1YTctxxxxxxxxxxxxxxxxxxxxxx"
# Ambiente: "production" para transações reais ou "sandbox" para testes
ASAAS_ENVIRONMENT="production"
# Token de autenticação configurado no Asaas (enviado no header 'asaas-access-token')
ASAAS_WEBHOOK_TOKEN="whsec_8RvJb3lvYWcwIE2pByN073lTotEFzN-BGFaehqMTzGI"

# 4. Z-API (Automação de WhatsApp Transacional Oficial)
# ID da Instância Z-API conectada ao número da nutricionista
ZAPI_INSTANCE_ID="3Cxxxxxxxxxxxxxxxxxxxxxx"
# Token da Instância Z-API
ZAPI_TOKEN="B8xxxxxxxxxxxxxxxxxxxxxx"
# Client-Token de segurança da sua conta Z-API (opcional, mas recomendado)
ZAPI_CLIENT_TOKEN="Fxxxxxxxxxxxxxxxxxxxxxxxx"
# URL base do endpoint da Z-API
ZAPI_BASE_URL="https://api.z-api.io"

# 5. REGRAS DE NEGÓCIO DO SISTEMA
PORT=3000
# Valor em Reais da consulta para geração automática da cobrança PIX
CONSULTATION_PRICE_BRL=79.00
# Minutos de tolerância para pagamento antes da liberação automática pelo Cron
PIX_EXPIRATION_MINUTES=15

# URL do app hospedado (injetada no Cloud Run ou VPS)
APP_URL="https://seu-dominio-ou-vps.com"
